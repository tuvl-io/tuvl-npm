{
  "name": "@tuvl/client",
  "version": "1.0.0",
  "description": "TypeScript client SDK for the tuvl workflow orchestration engine.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "author": "Sooraj <sooraj@tuvl.io>",
  "homepage": "https://tuvl.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuvl-io/tuvl-npm.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "workflow",
    "orchestration",
    "llm",
    "agents",
    "ai",
    "fastapi",
    "sse",
    "tuvl"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.1.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "bin": {
    "tuvl-client": "./dist/cli.js"
  }
}
