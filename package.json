{
  "name": "@tuvl/client",
  "version": "2.1.0-beta.1",
  "description": "TypeScript client for tuvl 2.0: start workflow runs, follow their journal over SSE, decide approvals, and generate typed workflow contracts from OpenAPI.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ."
  },
  "author": "tuvl.io <developer@tuvl.io>",
  "homepage": "https://tuvl.io",
  "bugs": {
    "url": "https://github.com/tuvl-io/tuvl-npm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuvl-io/tuvl-npm.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "workflow",
    "orchestration",
    "llm",
    "agents",
    "ai",
    "fastapi",
    "sse",
    "tuvl"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.8",
    "tsup": "^9.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "bin": {
    "tuvl-client": "./dist/cli.js"
  }
}
